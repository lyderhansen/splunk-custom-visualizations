{
  "label": "Heatmap",
  "entry": "visualization.js",
  "defaultSize": {
    "width": 720,
    "height": 360
  },
  "noDataMessage": "Heatmap \u2014 awaiting cells",
  "dependencies": [],
  "fields": [
    {
      "name": "_numRows",
      "label": "Number of rows",
      "type": "slider",
      "min": 3,
      "max": 11,
      "step": 1,
      "default": 8
    }
  ],
  "formatter": [
    {
      "name": "theme",
      "label": "Theme",
      "type": "radio",
      "options": [
        "dark",
        "light"
      ],
      "default": "dark"
    },
    {
      "name": "flavor",
      "label": "Flavor",
      "type": "radio",
      "options": [
        "mitre",
        "error"
      ],
      "default": "mitre"
    },
    {
      "name": "showCellValues",
      "label": "Show cell values",
      "type": "radio",
      "options": [
        "true",
        "false"
      ],
      "default": "true"
    },
    {
      "name": "sortOrder",
      "label": "Sort by total",
      "type": "radio",
      "options": [
        "none",
        "desc",
        "asc"
      ],
      "default": "none"
    },
    {
      "name": "cellLow",
      "label": "Low-bucket colour",
      "type": "color",
      "default": ""
    },
    {
      "name": "cellMid",
      "label": "Mid-bucket colour",
      "type": "color",
      "default": ""
    },
    {
      "name": "cellHigh",
      "label": "High-bucket colour",
      "type": "color",
      "default": "#ff6600"
    },
    {
      "name": "cellExtreme",
      "label": "Extreme-bucket colour",
      "type": "color",
      "default": "#d41f1f"
    },
    {
      "name": "cellPadding",
      "label": "Cell padding",
      "type": "text",
      "default": "3"
    },
    {
      "name": "cellRadius",
      "label": "Cell radius",
      "type": "text",
      "default": "2"
    },
    {
      "name": "maxCellHeight",
      "label": "Max cell height",
      "type": "text",
      "default": "22"
    },
    {
      "name": "labelColumnWidth",
      "label": "Label column width",
      "type": "text",
      "default": "130"
    },
    {
      "name": "valueFontSize",
      "label": "Value font size",
      "type": "text",
      "default": "10"
    },
    {
      "name": "labelFontSize",
      "label": "Label font size",
      "type": "text",
      "default": "12"
    },
    {
      "name": "showLegend",
      "label": "Show legend",
      "type": "radio",
      "options": [
        "true",
        "false"
      ],
      "default": "true"
    },
    {
      "name": "legendLow",
      "label": "Legend low label",
      "type": "text",
      "default": "Less"
    },
    {
      "name": "legendHigh",
      "label": "Legend high label",
      "type": "text",
      "default": "More"
    },
    {
      "name": "bgColor",
      "label": "Background colour",
      "type": "color",
      "default": "transparent"
    }
  ],
  "data": {
    "mode": "multi_row",
    "rowCountField": "_numRows",
    "columns": [
      "row",
      "vals"
    ],
    "sampleRows": [
      [
        "Initial Access",
        "0,2,1,3,0,5,2"
      ],
      [
        "Execution",
        "1,4,2,6,3,0,4"
      ],
      [
        "Persistence",
        "0,1,0,2,1,0,3"
      ],
      [
        "Privilege Escalation",
        "2,3,1,0,4,2,5"
      ],
      [
        "Defense Evasion",
        "3,5,4,7,2,1,6"
      ],
      [
        "Credential Access",
        "1,2,0,1,3,0,2"
      ],
      [
        "Discovery",
        "4,3,5,2,1,3,4"
      ],
      [
        "Lateral Movement",
        "0,1,2,0,3,1,2"
      ],
      [
        "Collection",
        "1,0,1,2,3,2,1"
      ],
      [
        "Exfiltration",
        "2,3,4,1,0,2,5"
      ],
      [
        "Impact",
        "0,2,3,1,2,4,3"
      ]
    ]
  }
}
