{
  "label": "Area Chart",
  "entry": "visualization.js",
  "defaultSize": {
    "width": 720,
    "height": 320
  },
  "noDataMessage": "Area chart \u2014 awaiting series",
  "dependencies": [],
  "fields": [
    {
      "name": "_numRows",
      "label": "Number of points",
      "type": "slider",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 24
    }
  ],
  "formatter": [
    {
      "name": "theme",
      "label": "Theme",
      "type": "radio",
      "options": [
        "dark",
        "light"
      ],
      "default": "dark"
    },
    {
      "name": "colors",
      "label": "Series colours",
      "type": "text",
      "default": "#ff6600,#2bbfb8,#7eb1ff"
    },
    {
      "name": "dashedSeries",
      "label": "Dashed series indices",
      "type": "text",
      "default": ""
    },
    {
      "name": "noFillSeries",
      "label": "No-fill series indices",
      "type": "text",
      "default": ""
    },
    {
      "name": "lineWidth",
      "label": "Line width",
      "type": "text",
      "default": "1.75"
    },
    {
      "name": "fillOpacity",
      "label": "Fill opacity",
      "type": "text",
      "default": "0.22"
    },
    {
      "name": "smooth",
      "label": "Smooth lines",
      "type": "radio",
      "options": [
        "false",
        "true"
      ],
      "default": "false"
    },
    {
      "name": "showPoints",
      "label": "Show data points",
      "type": "radio",
      "options": [
        "false",
        "true"
      ],
      "default": "false"
    },
    {
      "name": "pointSize",
      "label": "Point size",
      "type": "text",
      "default": "3"
    },
    {
      "name": "gridY",
      "label": "Y gridlines",
      "type": "text",
      "default": "4"
    },
    {
      "name": "showGrid",
      "label": "Show grid",
      "type": "radio",
      "options": [
        "true",
        "false"
      ],
      "default": "true"
    },
    {
      "name": "showXAxis",
      "label": "Show X axis",
      "type": "radio",
      "options": [
        "true",
        "false"
      ],
      "default": "true"
    },
    {
      "name": "showYAxis",
      "label": "Show Y axis",
      "type": "radio",
      "options": [
        "true",
        "false"
      ],
      "default": "true"
    },
    {
      "name": "xTickCount",
      "label": "X tick count",
      "type": "text",
      "default": "6"
    },
    {
      "name": "yUnit",
      "label": "Y unit suffix",
      "type": "text",
      "default": ""
    },
    {
      "name": "yMaxOverride",
      "label": "Y max override",
      "type": "text",
      "default": "0"
    },
    {
      "name": "legendPosition",
      "label": "Legend position",
      "type": "radio",
      "options": [
        "off",
        "top",
        "bottom"
      ],
      "default": "off"
    },
    {
      "name": "markerIdx",
      "label": "Marker index",
      "type": "text",
      "default": "-1"
    },
    {
      "name": "markerSeries",
      "label": "Marker series",
      "type": "text",
      "default": "0"
    },
    {
      "name": "markerLabel",
      "label": "Marker label",
      "type": "text",
      "default": ""
    },
    {
      "name": "padTop",
      "label": "Padding top",
      "type": "text",
      "default": "10"
    },
    {
      "name": "padRight",
      "label": "Padding right",
      "type": "text",
      "default": "16"
    },
    {
      "name": "padBottom",
      "label": "Padding bottom",
      "type": "text",
      "default": "26"
    },
    {
      "name": "padLeft",
      "label": "Padding left",
      "type": "text",
      "default": "44"
    },
    {
      "name": "bgColor",
      "label": "Background colour",
      "type": "color",
      "default": "transparent"
    }
  ],
  "data": {
    "mode": "multi_row",
    "rowCountField": "_numRows",
