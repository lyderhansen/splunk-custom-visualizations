{
  "label": "PoP Grid",
  "entry": "visualization.js",
  "defaultSize": {
    "width": 720,
    "height": 360
  },
  "noDataMessage": "PoP grid \u2014 awaiting sites",
  "dependencies": [],
  "fields": [
    {
      "name": "_numRows",
      "label": "Number of sites",
      "type": "slider",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 16
    }
  ],
  "formatter": [
    {
      "name": "theme",
      "label": "Theme",
      "type": "radio",
      "options": [
        "dark",
        "light"
      ],
      "default": "dark"
    },
    {
      "name": "columns",
      "label": "Columns",
      "type": "text",
      "default": "4"
    },
    {
      "name": "codeField",
      "label": "Code field",
      "type": "text",
      "default": "code"
    },
    {
      "name": "nameField",
      "label": "Name field",
      "type": "text",
      "default": "name"
    },
    {
      "name": "statusField",
      "label": "Status field",
      "type": "text",
      "default": "status"
    },
    {
      "name": "utilField",
      "label": "Util field",
      "type": "text",
      "default": "util"
    },
    {
      "name": "sortOrder",
      "label": "Sort order",
      "type": "radio",
      "options": [
        "none",
        "severity",
        "util-desc",
        "util-asc",
        "code"
      ],
      "default": "none"
    },
    {
      "name": "maxCells",
      "label": "Max cells (0=all)",
      "type": "text",
      "default": "0"
    },
    {
      "name": "showStatusDot",
      "label": "Show status dot",
      "type": "radio",
      "options": [
        "true",
        "false"
      ],
      "default": "true"
    },
    {
      "name": "showUtil",
      "label": "Show util bar",
      "type": "radio",
      "options": [
        "true",
        "false"
      ],
      "default": "true"
    },
    {
      "name": "codeFontSize",
      "label": "Code font size",
      "type": "text",
      "default": "13"
    },
    {
      "name": "nameFontSize",
      "label": "Name font size",
      "type": "text",
      "default": "11"
    },
    {
      "name": "utilFontSize",
      "label": "Util font size",
      "type": "text",
      "default": "10"
    },
    {
      "name": "utilBarHeight",
      "label": "Util bar height",
      "type": "text",
      "default": "4"
    },
    {
      "name": "cellRadius",
      "label": "Cell radius",
      "type": "text",
      "default": "4"
    },
    {
      "name": "cellPadding",
      "label": "Cell padding",
      "type": "text",
      "default": "10"
    },
    {
      "name": "gap",
      "label": "Gap",
      "type": "text",
      "default": "10"
    },
    {
      "name": "sidePadding",
      "label": "Side padding",
      "type": "text",
      "default": "12"
    },
    {
      "name": "minCellHeight",
      "label": "Min cell height",
      "type": "text",
      "default": "64"
    },
    {
      "name": "maxCellHeight",
      "label": "Max cell height",
      "type": "text",
      "default": "100"
    },
    {
      "name": "cellBgColor",
      "label": "Cell background",
      "type": "color",
      "default": ""
    },
    {
      "name": "bgColor",
      "label": "Background colour",
      "type": "color",
      "default": "transparent"
    }
  ],
  "data": {
    "mode": "multi_row",
    "rowCountField": "_numRows",
    "columns": [
      "code",
      "name",
      "status",
      "util"
    ],
