{
  "label": "Data Table",
  "defaultSize": {
    "width": 700,
    "height": 350
  },
  "fields": [],
  "formatter": [
    {
      "name": "theme",
      "label": "Theme",
      "type": "radio",
      "options": [
        "dark",
        "light"
      ],
      "default": "dark"
    },
    {
      "name": "maxRows",
      "label": "Max Rows",
      "type": "text",
      "default": "20"
    },
    {
      "name": "columnTypes",
      "label": "Column Types (JSON)",
      "type": "text",
      "default": ""
    },
    {
      "name": "thresholdField",
      "label": "Threshold Field",
      "type": "text",
      "default": ""
    },
    {
      "name": "thresholdWarn",
      "label": "Threshold Warn",
      "type": "text",
      "default": "50"
    },
    {
      "name": "thresholdDanger",
      "label": "Threshold Danger",
      "type": "text",
      "default": "80"
    }
  ],
  "data": {
    "mode": "multi_row",
