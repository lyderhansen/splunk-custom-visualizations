  "formatter": [
    { "name": "statusField", "label": "Status field", "type": "text", "default": "status" },
    { "name": "labelField", "label": "Label field", "type": "text", "default": "label" },
    { "name": "title", "label": "Title", "type": "text", "default": "" },
    { "name": "titleAlign", "label": "Title align", "type": "select", "options": ["left", "center", "right"], "default": "center" },
    { "name": "fontSize", "label": "Font size", "type": "text", "default": "0" },
    { "name": "theme", "label": "Theme", "type": "select", "options": ["dark", "light"], "default": "dark" }
  ],
  "data": {
    "mode": "single_row",
